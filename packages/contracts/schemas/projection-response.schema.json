{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caporal.ai/schemas/projection-response.schema.json",
  "title": "ProjectionResponse",
  "type": "object",
  "required": [
    "modelType",
    "confidence",
    "horizonDays",
    "projectedDailyGainKg",
    "projectedWeightSeries",
    "economicProjection",
    "sellSignal",
    "warnings"
  ],
  "properties": {
    "modelType": { "type": "string", "enum": ["xgboost", "linear_fallback"] },
    "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "horizonDays": { "type": "integer", "minimum": 7, "maximum": 180 },
    "projectedDailyGainKg": { "type": "number" },
    "projectedWeightSeries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "averageWeightKg"],
        "properties": {
          "day": { "type": "number" },
          "averageWeightKg": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "economicProjection": {
      "type": "object",
      "required": [
        "estimatedRevenueMxnPerHead",
        "estimatedCostMxnPerHead",
        "estimatedMarginMxnPerHead",
        "costPerKgGainMxn"
      ],
      "properties": {
        "estimatedRevenueMxnPerHead": { "type": "number" },
        "estimatedCostMxnPerHead": { "type": "number" },
        "estimatedMarginMxnPerHead": { "type": "number" },
        "costPerKgGainMxn": { "type": "number" }
      },
      "additionalProperties": false
    },
    "sellSignal": {
      "type": "object",
      "required": ["shouldSell", "recommendedDay", "expectedMarginTrend", "reason"],
      "properties": {
        "shouldSell": { "type": "boolean" },
        "recommendedDay": { "type": "integer", "minimum": 0 },
        "expectedMarginTrend": { "type": "string", "enum": ["UP", "STABLE", "DOWN"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

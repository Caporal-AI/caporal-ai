{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caporal.ai/schemas/ask-request.schema.json",
  "title": "AskRequest",
  "type": "object",
  "required": ["question", "dietContext", "retrievalOptions"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "dietContext": {
      "type": "object",
      "required": ["animalProfile", "dietMix", "constraintsReport"],
      "properties": {
        "animalProfile": {
          "type": "object",
          "required": ["intakeDmKgPerDay", "constraints"],
          "properties": {
            "intakeDmKgPerDay": { "type": "number", "exclusiveMinimum": 0 },
            "constraints": { "type": "array" }
          },
          "additionalProperties": true
        },
        "dietMix": { "type": "array", "items": { "type": "object" } },
        "constraintsReport": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "retrievalOptions": {
      "type": "object",
      "required": ["topK"],
      "properties": {
        "topK": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
